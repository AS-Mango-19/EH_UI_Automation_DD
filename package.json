{
  "name": "eh-ui-automation",
  "version": "1.0.0",
  "private": true,
  "description": "CSV-driven, metadata-driven UI regression framework for clinical-trial design (Playwright + TypeScript).",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "validate": "tsx core/cli/index.ts validate",
    "generate": "tsx core/cli/index.ts generate",
    "test": "tsx core/cli/index.ts test",
    "codegen": "tsx scripts/codegen.ts",
    "cleanup:orphans": "tsx core/cli/index.ts cleanup:orphans",
    "report:share": "tsx scripts/share-report.ts",
    "scaffold-feature": "tsx scripts/scaffold-feature.ts",
    "import-codegen": "tsx scripts/import-codegen.ts",
    "pw:test": "playwright test",
    "xlsx-to-csv": "tsx scripts/xlsx-to-csv.ts",
    "unit": "node --import tsx --test tests/unit/*.test.ts",
    "itest": "node --import tsx --test tests/integration/*.test.ts",
    "typecheck": "tsc --noEmit",
    "check-recordings": "tsx scripts/check-recordings.ts",
    "prepare": "git config core.hooksPath .githooks || exit 0"
  },
  "dependencies": {
    "@faker-js/faker": "^9.0.0",
    "dotenv": "^16.4.5",
    "luxon": "^3.5.0",
    "papaparse": "^5.4.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.48.0",
    "@types/luxon": "^3.4.2",
    "@types/node": "^20.14.0",
    "@types/papaparse": "^5.3.14",
    "playwright": "^1.48.0",
    "tsx": "^4.19.0",
    "typescript": "^5.5.4",
    "xlsx": "^0.18.5"
  }
}

# Secrets & local env
# Ignore ALL .env variants (incl. .bak copies) except the safe template.
# A narrow `.env` + `.env.*.local` once let .env.bak-180754 slip in with real creds.
.env
.env.*
!.env.example

# Codegen recordings — Playwright codegen captures the LOGIN steps verbatim,
# including the typed password, so recordings hold real credentials. Never commit
# them. A recording can be named anything (recording.txt, codegen.ts,
# <Feature>.txt, "new 2.txt") and saved in any format codegen or a human picks.
#
# So this is an ALLOWLIST, not a blacklist. Blacklisting extensions only covered
# *.txt/*.ts directly in this folder — a recording.json, a .har, or one dropped in
# a subfolder would have sailed straight through. The only files that belong here
# are selectors.csv and (optionally) locators.json; everything else is ignored by
# default, whatever it is called.
**/02_selectors_repo/**
!**/02_selectors_repo/selectors.csv
!**/02_selectors_repo/locators.json

# Node
node_modules/

# Run outputs (never committed)
artifacts/
reports/
**/07_actual_results/*.csv
**/08_diffs/*
**/09_html_report/*

# Playwright
test-results/
playwright-report/
.auth/

# OS / editor
.DS_Store
Thumbs.db
*.log

# NOTE: 06_baseline/ is intentionally NOT ignored — baselines are committed.
# Generated POM/spec files ARE committed so diffs are reviewable, but are never hand-edited.

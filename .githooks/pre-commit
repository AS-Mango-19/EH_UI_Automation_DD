#!/bin/sh
# Pre-commit guard: block commits that would leak login credentials in committed
# Playwright recordings (**/02_selectors_repo/*recording*.txt). See
# scripts/check-recordings.ts for the rules and the fix.
#
# Activated repo-wide by `git config core.hooksPath .githooks` (run automatically by
# the npm "prepare" script on install). Emergency bypass (avoid): git commit --no-verify
#
# Fail-CLOSED on a found credential (blocks the commit); fail-OPEN only when the
# tooling to run the guard is unavailable, so a fresh checkout without deps can still
# commit — CI should run `npm run check-recordings` as the hard gate.
if ! command -v node >/dev/null 2>&1 || [ ! -d node_modules/tsx ]; then
  echo "check-recordings: guard skipped (node/tsx unavailable — run npm install)" >&2
  exit 0
fi

exec npx --no-install tsx scripts/check-recordings.ts
